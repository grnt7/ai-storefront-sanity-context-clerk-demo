# ── Sanity ────────────────────────────────────────────────────────────────
# Project ID + dataset: sanity.io/manage or `npx sanity init`
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Read token (Viewer role) — used by the agent's MCP connection:
#   npx sanity tokens add "Sanity Context" --role=viewer --yes --json
SANITY_API_READ_TOKEN=

# Write token (Editor role) — used for orders + conversation insights:
#   npx sanity tokens add "Trailhead Writer" --role=editor --yes --json
SANITY_API_WRITE_TOKEN=

# Sanity Context MCP endpoint. After `npm run seed` + `npx sanity schema deploy`:
#   https://api.sanity.io/v2026-03-03/context/mcp/<PROJECT_ID>/production/storefront?embeddings=true
# (?embeddings=true enables semantic ranking — requires embeddings on the dataset)
SANITY_CONTEXT_MCP_URL=

# ── Clerk ─────────────────────────────────────────────────────────────────
# clerk.com dashboard → API keys (or `clerk init`)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Anthropic ─────────────────────────────────────────────────────────────
# console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# Which agent.config document the chat route loads (seeded as "trail-guide")
AGENT_CONFIG_SLUG=trail-guide
